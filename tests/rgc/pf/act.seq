; Confirms the PolarFire "actual measured" (unsound reference, not a real
; WCET bound) base-admission result: with aberr removed from the analysis,
; the full 6-task suite fits when sized off a single warm-cache measurement
; instead of a proven worst case. Per-task utilization: startracker 2.3%,
; kalman 2.6%, low_pass_filter 2.6%, cfdp_chunk 3.4%, ccsds 0.8%,
; reed_solomon 0.7% -- trivially low everywhere on this platform, included
; only for completeness/context, not as evidence of soundness.
;
; Same binary/toolchain as NOEL-V (identical RISC-V ISA); no PolarFire
; buildroot/boot flow in this repo, deploy via whatever PolarFire-side
; mechanism is available.
;
; Default (mutex-protected) BPFPrimeTest binary. Same fd-sharing note as the
; NOEL-V sequences applies (startracker/kalman/low_pass_filter in the 1Hz
; group share fd2/fd4).

; ---- Map setup ----

R00:00:01 BPFPrimeTest.bpfSequencer.BPF_MAP_CREATE 0, BPF_MAP_TYPE_ARRAY, 4, 4, 7, 0
R00:00:01 BPFPrimeTest.tests.POPULATE_MAP_RANDOM, 0, 0, 7
R00:00:01 BPFPrimeTest.bpfSequencer.BPF_MAP_CREATE 1, BPF_MAP_TYPE_ARRAY, 4, 4, 7, 0
R00:00:01 BPFPrimeTest.tests.POPULATE_MAP_RANDOM, 1, 0, 7
R00:00:01 BPFPrimeTest.bpfSequencer.BPF_MAP_CREATE 2, BPF_MAP_TYPE_ARRAY, 4, 4, 7, 0
R00:00:01 BPFPrimeTest.tests.POPULATE_MAP_RANDOM, 2, 0, 7

R00:00:01 BPFPrimeTest.bpfSequencer.BPF_MAP_CREATE 3, BPF_MAP_TYPE_ARRAY, 4, 4, 7, 0
R00:00:01 BPFPrimeTest.tests.POPULATE_MAP_RANDOM, 3, 0, 7
R00:00:01 BPFPrimeTest.bpfSequencer.BPF_MAP_CREATE 4, BPF_MAP_TYPE_ARRAY, 4, 4, 7, 0
R00:00:01 BPFPrimeTest.tests.POPULATE_MAP_RANDOM, 4, 0, 7

R00:00:01 BPFPrimeTest.bpfSequencer.BPF_MAP_CREATE 15, BPF_MAP_TYPE_ARRAY, 4, 4, 16, 0
R00:00:01 BPFPrimeTest.tests.POPULATE_MAP_RANDOM, 15, 0, 16
R00:00:01 BPFPrimeTest.bpfSequencer.BPF_MAP_CREATE 16, BPF_MAP_TYPE_ARRAY, 4, 4, 20, 0

R00:00:01 BPFPrimeTest.bpfSequencer.BPF_MAP_CREATE 17, BPF_MAP_TYPE_ARRAY, 4, 4, 16, 0
R00:00:01 BPFPrimeTest.tests.POPULATE_MAP_RANDOM, 17, 0, 16
R00:00:01 BPFPrimeTest.bpfSequencer.BPF_MAP_CREATE 18, BPF_MAP_TYPE_ARRAY, 4, 4, 4, 0

R00:00:01 BPFPrimeTest.bpfSequencer.BPF_MAP_CREATE 19, BPF_MAP_TYPE_ARRAY, 4, 4, 64, 0
R00:00:01 BPFPrimeTest.tests.POPULATE_MAP_RANDOM, 19, 0, 64
R00:00:01 BPFPrimeTest.bpfSequencer.BPF_MAP_CREATE 20, BPF_MAP_TYPE_ARRAY, 4, 4, 1, 0
R00:00:01 BPFPrimeTest.bpfSequencer.BPF_MAP_CREATE 21, BPF_MAP_TYPE_ARRAY, 4, 4, 11, 0

; ---- Load one VM instance per program ----

R00:00:01 BPFPrimeTest.bpfSequencer.LOAD_SEQUENCE 0, "tests/startracker/a.o"
R00:00:01 BPFPrimeTest.bpfSequencer.LOAD_SEQUENCE 1, "tests/kalman/a.o"
R00:00:01 BPFPrimeTest.bpfSequencer.LOAD_SEQUENCE 2, "tests/low_pass_filter/a.o"
R00:00:01 BPFPrimeTest.bpfSequencer.LOAD_SEQUENCE 3, "tests/cfdp_chunk/a.o"
R00:00:01 BPFPrimeTest.bpfSequencer.LOAD_SEQUENCE 4, "tests/ccsds/a.o"
R00:00:01 BPFPrimeTest.bpfSequencer.LOAD_SEQUENCE 5, "tests/reed_solomon/a.o"

; ---- Start the rate groups (1s buffer after loads) ----

; 1Hz
R00:00:02 BPFPrimeTest.bpfSequencer.SetVMRateGroup 0, 1.0, 22.56
R00:00:02 BPFPrimeTest.bpfSequencer.SetVMRateGroup 1, 1.0, 25.72
R00:00:02 BPFPrimeTest.bpfSequencer.SetVMRateGroup 2, 1.0, 25.83
R00:00:02 BPFPrimeTest.bpfSequencer.SetVMRateGroup 3, 1.0, 33.66

; 0.1Hz
R00:00:02 BPFPrimeTest.bpfSequencer.SetVMRateGroup 4, 0.1, 80.23
R00:00:02 BPFPrimeTest.bpfSequencer.SetVMRateGroup 5, 0.1, 69.40

; Watch for: zero SchedulerSlip events on vm 0-5 over an extended run. Since
; this row uses unsound (measured, not proven-worst-case) timing, a slip
; here would be the least surprising of the six -- but it's still worth
; running as the baseline reference for what "runs fine in practice" looks
; like against the two sound bounds above it.
